M-010 sqlite3GetVarint 38029 '<<7' '<<8' card=C-02
M-011 sqlite3GetVarint 38150 '<<15' '<<14' card=C-02
M-012 sqlite3GetVarint 38161 'p[-4]' 'p[-5]' card=C-02
